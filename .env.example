from __future__ import annotations

from typing import Any

import httpx

from app.config import settings


class ServiceUnavailableError(RuntimeError):
    pass


class ProviderFactory:
    @staticmethod
    def get_provider(service_name: str) -> "BaseProvider":
        return BaseProvider(service_name)


class BaseProvider:
    def __init__(self, service_name: str):
        self.service_name = service_name

    @property
    def is_configured(self) -> bool:
        if self.service_name in {"image_generation", "text_generation", "summarize", "translate", "speech_to_text", "text_to_speech"}:
            return bool(settings.OPENAI_API_KEY)
        if self.service_name == "background_removal":
            return bool(settings.REMOVE_BG_API_KEY)
        if self.service_name == "video_generation":
            return bool(settings.STABILITY_API_KEY)
        if self.service_name == "image_enhancement":
            return bool(settings.OPENAI_API_KEY or settings.STABILITY_API_KEY)
        return False

    async def _openai_request(self, method: str, endpoint: str, *, json_body: dict[str, Any] | None = None, files: dict[str, Any] | None = None) -> dict[str, Any]:
        key = settings.OPENAI_API_KEY
        if not key:
            raise ServiceUnavailableError("خدمة الذكاء الاصطناعي غير مهيأة بعد: OPENAI_API_KEY غير موجود.")

        headers = {"Authorization": f"Bearer {key}"}
        if files is None:
            headers["Content-Type"] = "application/json"

        async with httpx.AsyncClient(timeout=90.0) as client:
            response = await client.request(method, f"https://api.openai.com/v1{endpoint}", headers=headers, json=json_body, files=files)
            payload = response.json() if response.content else {}
            if response.status_code >= 400:
                msg = payload.get("error", {}).get("message", payload.get("message", "OpenAI API request failed."))
                raise ServiceUnavailableError(f"فشل مزود OpenAI: {msg}")
            return payload

    async def generate_image(self, prompt: str, **kwargs: Any) -> dict[str, Any]:
        if not self.is_configured:
            raise ServiceUnavailableError("خدمة توليد الصور غير مهيأة بعد. أضف OPENAI_API_KEY في Railway.")
        payload = {"model": "gpt-image-1", "prompt": prompt, "size": kwargs.get("size", "1024x1024")}
        result = await self._openai_request("POST", "/images/generations", json_body=payload)
        return {"success": True, "provider": "openai", "result": result}

    async def remove_background(self, image_url: str, **kwargs: Any) -> dict[str, Any]:
        if not settings.REMOVE_BG_API_KEY:
            raise ServiceUnavailableError("خدمة إزالة الخلفية غير مهيأة بعد: REMOVE_BG_API_KEY غير موجود.")
        async with httpx.AsyncClient(timeout=90.0) as client:
            response = await client.post(
                "https://api.remove.bg/v1.0/removebg",
                files={"image_file": ("image.png", image_url.encode("utf-8"), "image/png")},
                data={"size": "auto"},
                headers={"X-Api-Key": settings.REMOVE_BG_API_KEY},
            )
            if response.status_code >= 400:
                raise ServiceUnavailableError(f"فشل Remove.bg: {response.text[:200]}")
            return {"success": True, "provider": "remove.bg", "content_type": response.headers.get("content-type"), "bytes": len(response.content)}

    async def generate_text(self, prompt: str, **kwargs: Any) -> dict[str, Any]:
        if not self.is_configured:
            raise ServiceUnavailableError("خدمة الكتابة غير مهيأة بعد. أضف OPENAI_API_KEY.")
        payload = {"model": "gpt-4o-mini", "messages": [{"role": "user", "content": prompt}], "temperature": 0.7}
        result = await self._openai_request("POST", "/chat/completions", json_body=payload)
        return {"success": True, "provider": "openai", "text": result["choices"][0]["message"]["content"]}

    async def summarize(self, text: str, **kwargs: Any) -> dict[str, Any]:
        if not self.is_configured:
            raise ServiceUnavailableError("خدمة التلخيص غير مهيأة بعد.")
        prompt = f"لخص هذا النص باللغة العربية بشكل موجز:\n\n{text}"
        result = await self._openai_request("POST", "/chat/completions", json_body={"model": "gpt-4o-mini", "messages": [{"role": "user", "content": prompt}]})
        return {"success": True, "provider": "openai", "summary": result["choices"][0]["message"]["content"]}

    async def translate(self, text: str, target_language: str = "ar", **kwargs: Any) -> dict[str, Any]:
        if not self.is_configured:
            raise ServiceUnavailableError("خدمة الترجمة غير مهيأة بعد. أضف OPENAI_API_KEY.")
        prompt = f"ترجم النص التالي إلى اللغة {target_language} مع الحفاظ على المعنى:\n\n{text}"
        result = await self._openai_request("POST", "/chat/completions", json_body={"model": "gpt-4o-mini", "messages": [{"role": "user", "content": prompt}]})
        return {"success": True, "provider": "openai", "translation": result["choices"][0]["message"]["content"]}

    async def text_to_speech(self, text: str, **kwargs: Any) -> dict[str, Any]:
        if not self.is_configured:
            raise ServiceUnavailableError("خدمة تحويل النص إلى صوت غير مهيأة بعد: OPENAI_API_KEY غير موجود.")
        payload = {"model": "tts-1", "voice": kwargs.get("voice", "alloy"), "input": text}
        result = await self._openai_request("POST", "/audio/speech", json_body=payload)
        return {"success": True, "provider": "openai", "media": result}

    async def speech_to_text(self, audio_url: str, **kwargs: Any) -> dict[str, Any]:
        if not self.is_configured:
            raise ServiceUnavailableError("خدمة تحويل الصوت إلى نص غير مهيأة بعد.")
        async with httpx.AsyncClient(timeout=120.0) as client:
            resp = await client.get(audio_url)
            resp.raise_for_status()
            payload = {"model": "gpt-4o-transcribe", "file": ("audio.mp3", resp.content, "audio/mpeg")}
            headers = {"Authorization": f"Bearer {settings.OPENAI_API_KEY}"}
            result = await client.post("https://api.openai.com/v1/audio/transcriptions", headers=headers, files=payload)
            data = result.json() if result.content else {}
            if result.status_code >= 400:
                raise ServiceUnavailableError(f"فشل OpenAI transcription: {data.get('error', {}).get('message', 'unknown error')}")
            return {"success": True, "provider": "openai", "transcript": data.get("text", "")}

    async def generate_video(self, prompt: str, **kwargs: Any) -> dict[str, Any]:
        if not settings.STABILITY_API_KEY:
            raise ServiceUnavailableError("خدمة إنشاء الفيديو غير مهيأة بعد: STABILITY_API_KEY غير موجود.")
        async with httpx.AsyncClient(timeout=120.0) as client:
            response = await client.post(
                "https://api.stability.ai/v2beta/stable-image/generate/core",
                headers={"Authorization": f"Bearer {settings.STABILITY_API_KEY}", "Content-Type": "application/json"},
                json={"text_prompts": [{"text": prompt}], "height": 1024, "width": 1024, "steps": 25, "cfg_scale": 7},
            )
            if response.status_code >= 400:
                raise ServiceUnavailableError(f"فشل Stability AI: {response.text[:200]}")
            return {"success": True, "provider": "stability", "raw": response.content[:100]}

    async def enhance_image(self, image_url: str, **kwargs: Any) -> dict[str, Any]:
        if not self.is_configured:
            raise ServiceUnavailableError("خدمة تحسين الصور غير مهيأة بعد.")
        return {"success": True, "provider": "openai", "image_url": image_url, "note": "تتطلب هذه الخدمة مزودًا خارجيًا حقيقيًا."}


def service_status(service_name: str) -> tuple[bool, str]:
    provider = ProviderFactory.get_provider(service_name)
    return provider.is_configured, (
        "الخدمة جاهزة ومهيأة" if provider.is_configured else "هذه الخدمة غير مهيأة بعد. أ��ف مفاتيح API في Railway لتمكينها."
    )
